<?xml version="1.0" encoding="UTF-8"?>
<!--
  Files bundled inside the easymux program (a GResource).
  The prefix matches our app ID (dev.easymux.Easymux), so GTK finds the icons
  under /dev/easymux/Easymux/icons automatically.
-->
<gresources>
  <gresource prefix="/dev/easymux/Easymux">
    <!-- Our stylesheet. libadwaita loads "style.css" from here automatically. -->
    <file>style.css</file>
    <!-- Shell integration scripts. Written out to a cache folder at startup,
         because shells can only load real files. -->
    <file>shell-integration/zsh/.zshenv</file>
    <file>shell-integration/zsh/easymux.zsh</file>
    <file>shell-integration/bash/easymux.bash</file>
    <!-- Icons from Lucide (https://lucide.dev), ISC license: see icons/LICENSE-lucide.txt -->
    <file>icons/scalable/actions/easymux-split-right-symbolic.svg</file>
    <file>icons/scalable/actions/easymux-split-down-symbolic.svg</file>
    <file>icons/scalable/actions/easymux-close-pane-symbolic.svg</file>
    <file>icons/scalable/actions/easymux-new-tab-symbolic.svg</file>
  </gresource>
</gresources>
